<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="cloud.hubera.music" />
        <package android:name="ovh.delhomme.ytmusic" />
        <package android:name="cloud.hubera.fuel" />
        <package android:name="com.gasoiltracking.app" />
        <package android:name="cloud.hubera.contacts" />
        <package android:name="fr.cloudity.cloudity_contacts" />
        <package android:name="cloud.hubera.docs" />
        <package android:name="cloud.hubera.mail" />
        <package android:name="cloud.hubera.id" />
        <package android:name="cloud.hubera.pass" />
        <package android:name="cloud.hubera.calendar" />
        <package android:name="fr.cloudity.cloudity_calendar" />
        <package android:name="cloud.hubera.jobs" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="gasoiltracking" />
        </intent>
        <intent>
            <action android:name="com.gasoiltracking.app.MAPS_CONTROL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ytmusic" />
        </intent>
        <intent>
            <action android:name="androidx.media3.session.MediaSessionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:scheme="content" />
        </intent>
    </queries>
    <application
        android:label="Hubera Maps"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HuberaMaps">
        <service
            android:name=".TripKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${mapsFuelScheme}" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloudity-maps" />
            </intent-filter>
            <!-- Fuel / liens https → app native (pas le navigateur) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.hubera.cloud" />
            </intent-filter>
        </activity>
    </application>
</manifest>
